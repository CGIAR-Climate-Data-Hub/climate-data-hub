---
import { getCollection } from "astro:content";
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
import DataGlyph from "@/components/DataGlyph.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { currentReleases, summarize } from "@/lib/catalog";
import { allTutorials } from "@/lib/collections";
import { GITHUB_URL, SITE_NAME } from "@/site.config";

// The two most recently updated releases represent the catalog here
const datasets = currentReleases(await getCollection("catalog"))
  .map(summarize)
  .sort((a, b) => b.updated.localeCompare(a.updated))
  .slice(0, 2);
const tutorials = (await allTutorials()).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf(),
);
const wikis = (await getCollection("wikis"))
  .filter((w) => w.data.order !== undefined)
  .sort(
    (a, b) =>
      (a.data.order ?? 0) - (b.data.order ?? 0)
      || a.data.title.localeCompare(b.data.title),
  )
  .slice(0, 2);

// One begin-here list mixing the collections; grows with the content.
const essentials = [
  ...datasets.map((d) => ({
    href: `/catalog/${d.id}/`,
    name: d.title,
    badge: "Dataset",
    meta: [d.coverage, d.temporal].filter(Boolean).join(" · "),
    glyph: d.type,
  })),
  ...tutorials.slice(0, 2).map((t) => ({
    href: `/tutorials/${t.id}/`,
    name: t.data.title,
    badge: "Tutorial",
    meta: `${t.data.audience} · ${t.data.time}`,
    glyph: undefined,
  })),
  ...wikis.map((w) => ({
    href: `/wikis/${w.id}/`,
    name: w.data.title,
    badge: "Wiki",
    meta: w.data.section,
    glyph: undefined,
  })),
];

const PATHS = [
  {
    href: "/catalog/",
    label: "Find a specific dataset",
    cue: "Search & filter",
  },
  {
    href: "/tutorials/",
    label: "Learn how to use the data",
    cue: "Runnable tutorials",
  },
  {
    href: "/contribute/",
    label: "Contribute data or docs",
    cue: "Add to the Hub",
  },
  {
    href: "/ai/",
    label: "Use the Hub with AI",
    cue: "Skills & agent access",
  },
];

const PRINCIPLES = [
  [
    "Quality-assured",
    "Every dataset is reviewed, documented and versioned before it lands — so you can trust what you build on.",
  ],
  [
    "One shared standard",
    "STAC items and a common schema mean discovery, citation and access work the same way for every layer.",
  ],
  [
    "Openly licensed",
    "CC-BY by default. Cite the source and reuse freely — for research, decision-support or finance.",
  ],
  [
    "Cloud-native & interoperable",
    "COG and Zarr: query data where it lives, or stream just the window you need — no bespoke plumbing.",
  ],
];
---

<Layout title={`${SITE_NAME} — Climate evidence, decision-ready`}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="statement">
        <div class="label kicker">CGIAR · Climate Action</div>
        <h1>Climate evidence,<br>decision-ready.</h1>
        <p class="lede">
          One quality-assured home for climate data, tools, and documentation
          across CGIAR — consistently formatted, openly licensed, and ready to
          use.
        </p>

        <PagefindConfig instance="hero" />
        <pagefind-searchbox
          class="paper-search"
          instance="hero"
          placeholder="Search datasets, docs, and tutorials"
          shortcut="/"
        ></pagefind-searchbox>
      </div>

      <div class="paths">
        <div class="label kicker start-here">Start here</div>
        {PATHS.map((p, i) => (
            <a class="path" href={p.href}>
              <span class="mono path-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="path-text">
                <span class="path-label">{p.label}</span>
                <span class="label path-cue">{p.cue}</span>
              </span>
              <svg aria-hidden="true" class="path-arrow" fill="none" height="17" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="17">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          ))}
      </div>
    </div>
  </section>

  <section class="essentials">
    <div class="container">
      <SectionHeader
        kicker="Highlights"
        sub="A curated mix of datasets, tutorials, and reference docs — the pieces most climate work on the Hub is built on."
        title="Featured data & lessons"
      >
        <a class="btn btn-ghost" href="/catalog/" slot="right"
          >Browse the catalog →</a
        >
      </SectionHeader>

      <div class="essentials-grid">
        {essentials.map((item) => (
            <a class="essential" href={item.href}>
              <span class="essential-kind">
                <span class="essential-glyph">
                  {item.glyph ? (
                    <DataGlyph size={19} type={item.glyph} />
                  ) : (
                    <svg aria-hidden="true" fill="none" height="19" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" viewBox="0 0 24 24" width="19">
                      <path d="M7 3h7l5 5v13H7V3Zm7 0v5h5M10 12h6M10 16h6" />
                    </svg>
                  )}
                </span>
                <span class="label">{item.badge}</span>
              </span>
              <span class="essential-text">
                <span class="essential-name">{item.name}</span>
                <span class="essential-meta">
                  <span class="mono">{item.meta}</span>
                </span>
              </span>
              <svg aria-hidden="true" class="essential-arrow" fill="none" height="16" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="16">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          ))}
      </div>
    </div>
  </section>

  <section class="principles">
    <div class="container">
      <div class="principles-band">
        <div>
          <div class="label band-kicker">Why the Hub works this way</div>
          <h2>Findable once.<br>Usable everywhere.</h2>
          <p class="band-lede">
            Climate evidence across CGIAR used to live in scattered formats and
            portals. The Hub brings it under one set of principles, so teams can
            build on each other's work instead of starting over.
          </p>
          <a class="band-link" href="/about/">More about the Hub →</a>
        </div>
        <div>
          {PRINCIPLES.map(([title, body], i) => (
              <div class="principle">
                <span class="mono principle-n">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <div class="principle-title">{title}</div>
                  <p>{body}</p>
                </div>
              </div>
            ))}
        </div>
      </div>
    </div>
  </section>

  <section class="contribute">
    <div class="container contribute-band">
      <div>
        <h2>The Hub grows because people add to it.</h2>
        <p>
          If your team holds climate-relevant data, a reusable tool, or a story
          worth telling, there is a clear path in.
        </p>
      </div>
      <div class="contribute-ctas">
        <a class="btn btn-accent" href="/contribute/">Contribute a dataset</a>
        <a class="btn btn-ghost" href={GITHUB_URL}>Open on GitHub</a>
      </div>
    </div>
  </section>
</Layout>

<style>
/* ---- Hero: pale brand field, program-blue index bleeding right ---- */
.hero {
  position: relative;
  overflow-x: clip;
  background: var(--cdh-blue-50);
}

.hero-grid {
  position: relative;
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 56px;
  align-items: stretch;
  padding-block: 56px;
}

.statement {
  max-width: 620px;
}

h1 {
  font-size: clamp(44px, 5.2vw, 68px);
  line-height: 1.06;
  letter-spacing: -0.03em;
}

.lede {
  max-width: 500px;
  margin-top: var(--space-5);
  font-family: var(--serif);
  font-size: var(--font-size-6);
  font-weight: 300;
  line-height: 1.6;
  color: var(--text-soft);
}

.paper-search {
  --pf-font: var(--sans);
  --pf-background: var(--surface);
  --pf-border: var(--border-strong);
  --pf-border-focus: var(--cdh-blue-700);
  --pf-border-radius: var(--radius-sm);
  --pf-outline-width: 0px;

  display: block;
  min-height: 59px; /* input height, reserved so JS render doesn't shift layout */
  margin-top: var(--space-6);
}

.paper-search:hover {
  --pf-border: var(--cdh-blue-300);
}

.paper-search:focus-within {
  --pf-border: var(--cdh-blue-700);
}

.paths {
  --text-mute: var(--cdh-blue-950);

  position: relative;
  z-index: 0;
  display: flex;
  flex-direction: column;
  padding-top: 0;
  padding-bottom: var(--space-4);
  margin: 0;
}

/* The flat brand field begins at the index and continues to the viewport edge. */
.paths::before {
  position: absolute;
  top: calc(-1 * var(--space-4));
  bottom: 0;
  left: 0;
  z-index: -1;
  width: 100vw;
  content: "";
  background: var(--cdh-blue-300);
}

.statement > .kicker,
.kicker.start-here {
  font-size: var(--font-size-4);
  font-weight: 700;
}

.kicker.start-here {
  padding: 0 28px var(--space-5);
  margin-bottom: 0;
  font-size: var(--font-size-5);
  color: var(--cdh-blue-950);
  background: none;
}

.path {
  display: flex;
  flex: 1;
  gap: var(--space-4);
  align-items: center;
  min-height: 68px;
  padding: var(--space-3) 28px;
  color: var(--cdh-blue-950);
  transition: background-color 0.16s;
}

.path:is(:hover, :focus-visible) {
  text-decoration: none;
  background: var(--cdh-blue-950);
}

.path:is(:hover, :focus-visible)
  :is(.path-num, .path-label, .path-cue, .path-arrow) {
  color: var(--text-inverse);
}

.path-num {
  flex-shrink: 0;
  font-size: var(--font-size-3);
  color: var(--cdh-blue-800);
  transition: color 0.16s;
}

.path-text {
  flex: 1;
  min-width: 0;
  transition: transform 0.16s;
}

.path-label {
  display: block;
  font-family: var(--sans);
  font-size: var(--font-size-7);
  font-weight: 700;
  line-height: 1.25;
  color: var(--cdh-blue-950);
}

.path-cue {
  display: block;
  margin-top: var(--space-1);
  font-size: var(--font-size-1);
  color: var(--text-mute);
}

.path-arrow {
  flex-shrink: 0;
  color: var(--text-mute);
  transition: transform 0.16s;
}

.path:is(:hover, :focus-visible) .path-text {
  transform: translateX(var(--space-2));
}

.path:is(:hover, :focus-visible) .path-arrow {
  transform: translateX(4px);
}

/* ---- Essentials ---- */
.essentials {
  padding: 84px 0 var(--space-2);
}

.essentials-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 56px;
  border-top: 1px solid var(--border);
}

.essential {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: var(--space-4);
  align-items: center;
  padding: 18px 6px;
  color: var(--text);
  border-bottom: 1px solid var(--border);
  transition: background 0.12s;
}

.essential:hover {
  text-decoration: none;
  background: var(--surface);
}

/* The kind reads as a marker column — glyph over label — instead of a pill in
   the meta line. Keeping every glyph navy avoids adding a competing colour
   system to the featured list and matches each card's title. */
.essential-kind {
  display: flex;
  flex-direction: column;
  gap: 3px;
  align-items: center;
  color: var(--cdh-blue-950);
}

.essential-glyph {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 22px;
}

.essential-glyph :global(.glyph) {
  width: auto;
  height: auto;
  color: inherit;
  background: none;
}

.essential-text {
  min-width: 0;
}

.essential-name {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: var(--font-size-6);
  font-weight: 600;
  color: var(--cdh-blue-950);
  white-space: nowrap;
}

.essential-meta {
  display: flex;
  gap: 9px;
  align-items: center;
  margin-top: var(--space-1);
}

.essential-meta .mono {
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: var(--font-size-3);
  color: var(--text-mute);
  white-space: nowrap;
}

.essential-arrow {
  color: var(--text-mute);
}

/* ---- Principles band (navy — text uses inverse or program-blue tokens) ---- */
.principles {
  padding: 72px 0 var(--space-2);
}

.principles-band {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 56px;
  align-items: start;
  padding: 52px 56px;
  overflow: hidden;
  color: var(--text-inverse);
  background: var(--cdh-blue-950);
  border-radius: var(--radius-lg);
}

.band-kicker {
  margin-bottom: var(--space-4);
  color: var(--cdh-blue-300);
}

.principles-band h2 {
  font-size: var(--font-size-10);
  line-height: 1.15;
  color: var(--text-inverse);
}

.band-lede {
  max-width: 400px;
  margin-top: var(--space-4);
  font-size: var(--font-size-6);
  line-height: 1.65;
  color: var(--text-inverse-soft);
}

.band-link {
  display: inline-block;
  margin-top: 22px;
  font-size: var(--font-size-5);
  font-weight: 600;
  color: var(--cdh-blue-300);
}

.principle {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 18px;
  align-items: baseline;
  padding: 18px 0;
  border-top: 1px solid var(--border-inverse);
}

.principle:first-child {
  border-top: 0;
}

.principle-n {
  font-size: var(--font-size-2);
  color: var(--terra-300);
}

.principle-title {
  font-family: var(--serif);
  font-size: var(--font-size-8);
  font-weight: 500;
  color: var(--text-inverse);
}

.principle p {
  margin-top: 5px;
  font-size: var(--font-size-5);
  line-height: 1.6;
  color: var(--text-inverse-soft);
}

/* ---- Contribute band ---- */
.contribute {
  padding: 72px 0 var(--space-2);
}

.contribute-band {
  display: flex;
  flex-wrap: wrap;
  gap: 40px;
  align-items: center;
  justify-content: space-between;
  padding-top: 40px;
  border-top: 1px solid var(--border);
}

.contribute-band h2 {
  font-size: var(--font-size-10);
}

.contribute-band p {
  max-width: 620px;
  margin-top: var(--space-3);
  font-size: var(--font-size-6);
  line-height: 1.6;
  color: var(--text-soft);
}

.contribute-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

@media (width <= 960px) {
  .hero-grid {
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding-block: 36px 0;
  }

  .paper-search {
    margin-top: var(--space-5);
  }

  .paths {
    padding-top: var(--space-6);
    padding-bottom: var(--space-4);
  }

  .paths::before {
    top: 0;
    left: calc(50% - 50vw);
  }

  .path {
    min-height: 70px;
    padding-block: var(--space-3);
  }

  .essentials-grid {
    grid-template-columns: 1fr;
  }

  .principles-band {
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding: 36px 28px;
  }
}
</style>
