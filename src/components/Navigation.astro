---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
import { GITHUB_URL, SITE_NAME } from "@/site.config";
import LogoBlock from "./LogoBlock.astro";

const LEARN = [
  { href: "/wikis/", label: "Wikis", desc: "Reference & standards" },
  { href: "/tutorials/", label: "Tutorials", desc: "Runnable, step-by-step" },
];

const ABOUT = [
  { href: "/about/", label: "About the Hub", desc: "Mission & principles" },
  { href: "/faq/", label: "FAQ", desc: "Common questions, answered" },
];

// Bar order. An entry with `items` renders as a dropdown, and its parent link
// goes to the first thing under it; the mobile menu lists the items instead.
const NAV: { href: string; label: string; items?: typeof LEARN }[] = [
  { href: "/catalog/", label: "Catalog" },
  { href: "/wikis/", label: "Learn", items: LEARN },
  { href: "/in-use/", label: "In use" },
  { href: "/ai/", label: "AI tools" },
  { href: "/about/", label: "About", items: ABOUT },
];

// The mobile menu lists a dropdown's items in place of its parent link
type Link = { href: string; label: string };
const MOBILE = NAV.flatMap((item): Link[] => item.items ?? [item]);

const path = Astro.url.pathname;
// Hrefs end in "/", so prefix matching marks the whole section active —
// a record page keeps Catalog underlined, a tutorial keeps Learn underlined
const isActive = (href: string) => path.startsWith(href);
---

<PagefindConfig />

<header>
  <div class="container bar">
    <LogoBlock />

    <nav aria-label="Main">
      {NAV.map((item) =>
        item.items ? (
          <div class="dropdown">
            <a
              href={item.href}
              class:list={["nav-item", { "is-active": item.items.some((l) => isActive(l.href)) }]}
            >
              {item.label}
              <svg
                aria-hidden="true"
                fill="none"
                height="10"
                stroke="currentColor"
                stroke-width="2.4"
                viewBox="0 0 24 24"
                width="10"
              >
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </a>
            <div class="menu">
              {item.items.map((link) => (
                <a href={link.href} class:list={["menu-item", { "is-active": isActive(link.href) }]}>
                  <span class="menu-label">{link.label}</span>
                  <span class="menu-desc">{link.desc}</span>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={["nav-item", { "is-active": isActive(item.href) }]}
          >
            {item.label}
          </a>
        ),
      )}
    </nav>

    <div class="search">
      <pagefind-modal-trigger
        class="trigger-full"
        placeholder="Search the Hub"
      ></pagefind-modal-trigger>
      <pagefind-modal-trigger
        class="trigger-compact"
        compact
        hide-shortcut
      ></pagefind-modal-trigger>
      <pagefind-modal></pagefind-modal>
    </div>

    <a class="btn btn-ghost btn-cta cta" href="/contribute/">Contribute</a>

    <a aria-label={`${SITE_NAME} on GitHub`} class="gh" href={GITHUB_URL}>
      <svg
        aria-hidden="true"
        fill="currentColor"
        height="18"
        viewBox="0 0 24 24"
        width="18"
      >
        <path
          d="M12 .5C5.7.5.5 5.7.5 12.1c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2 1-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.6 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"
        ></path>
      </svg>
    </a>

    <button
      aria-label="Menu"
      class="menu-btn"
      popovertarget="mobile-menu"
      type="button"
    >
      <svg
        aria-hidden="true"
        fill="none"
        height="20"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="20"
      >
        <path class="i-open" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="i-close" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" popover>
    <nav aria-label="Mobile">
      {MOBILE.map((link) => (
          <a href={link.href} class:list={[{ "is-active": isActive(link.href) }]}>
            {link.label}
          </a>
        ))}
      <a href="/contribute/">Contribute</a>
      <a href={GITHUB_URL}>GitHub ↗</a>
    </nav>
  </div>
</header>

<script>
// Firefox hasn't shipped scroll-driven animations — toggle the glass effect
// the old way there. Supporting browsers skip this (the @supports CSS runs it).
if (!CSS.supports("animation-timeline: scroll(root)")) {
  const header = document.querySelector("header");
  const onScroll = () =>
    header?.toggleAttribute("data-scrolled", window.scrollY > 8);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();
}
</script>

<style>
header {
  position: sticky;
  top: 0;
  z-index: 30;
  background: var(--bg);
  border-bottom: 1px solid transparent;
  transition:
    background 0.2s,
    border-color 0.2s;
}

/* Glassy once scrolled — data-scrolled is the JS fallback path */
header[data-scrolled] {
  background: var(--navbar-glass);
  border-color: var(--border);
  backdrop-filter: blur(12px) saturate(160%);
}

/* Gated: without the timeline this runs as an instant 0s animation and
   fill-mode pins the glass on permanently */
@supports (animation-timeline: scroll(root)) {
  header {
    /* longhands on purpose: the CSS minifier merges an `animation` shorthand
       with `animation-timeline` into one invalid declaration browsers drop */
    animation-name: header-glass;
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: scroll(root);
    animation-range: 0 8px;
  }
}

@keyframes header-glass {
  to {
    background: var(--navbar-glass);
    border-color: var(--border);
    backdrop-filter: blur(12px) saturate(160%);
  }
}

.bar {
  display: flex;
  gap: 24px;
  align-items: center;
  height: var(--nav-height);
}

nav {
  display: flex;
  gap: 6px;
  align-items: center;
}

.nav-item {
  position: relative;
  display: inline-flex;
  gap: 5px;
  align-items: center;
  justify-content: center;
  min-width: 76px;
  padding: 6px 10px;
  font-size: var(--font-size-6);
  font-weight: 500;
  color: var(--grey-6);
  text-align: center;
  white-space: nowrap;
}

/* An open dropdown keeps its trigger lit: once the pointer is inside the menu
   the anchor is no longer :hover, but .dropdown still is */
.nav-item:hover,
.dropdown:hover .nav-item,
.dropdown:focus-within .nav-item {
  color: var(--cdh-blue-950);
  text-decoration: none;
}

/* Hover: terracotta underline grows from centre — distinct from the program-blue
   active rule, and transient so it never competes with where you actually are */
.nav-item:not(.is-active)::after {
  position: absolute;
  right: 10px;
  bottom: -3px;
  left: 10px;
  height: 2px;
  content: "";
  background: var(--terra-700);
  border-radius: 2px;
  transform: scaleX(0);
  transform-origin: center;
  transition: transform 0.16s ease;
}

.nav-item:not(.is-active):hover::after,
.dropdown:hover .nav-item:not(.is-active)::after,
.dropdown:focus-within .nav-item:not(.is-active)::after {
  transform: scaleX(1);
}

.nav-item.is-active {
  color: var(--cdh-blue-950);
}

/* The primary #63A9FE, and 3px rather than the hover's 2px: it is only 2.21:1
   on paper, so the rule leans on area, and the label's navy (against grey-6
   when inactive) carries the state as well — the colour isn't load-bearing alone */
.nav-item.is-active::after {
  position: absolute;
  right: 10px;
  bottom: -3px;
  left: 10px;
  height: 3px;
  content: "";
  background: var(--cdh-blue-300);
  border-radius: 2px;
}

.dropdown {
  position: relative;
}

.menu {
  position: absolute;
  top: calc(100% + 10px);
  left: -12px;
  z-index: 40;
  display: none;
  flex-direction: column;
  min-width: 250px;
  padding: 7px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-menu);
}

/* Keep the hover gap bridged so the menu doesn't flicker closed */
.dropdown::after {
  position: absolute;
  inset: 100% 0 -12px;
  display: none;
  content: "";
}

.dropdown:hover .menu,
.dropdown:focus-within .menu,
.dropdown:hover::after {
  display: flex;
}

.menu-item {
  display: block;
  padding: 10px var(--space-3);
  text-decoration: none;
  border-radius: var(--radius-md);
}

.menu-item:hover {
  text-decoration: none;
  background: var(--bg);
}

.menu-item.is-active {
  background: var(--cdh-blue-50);
}

.menu-label {
  display: block;
  font-size: var(--font-size-5);
  font-weight: 600;
  color: var(--text);
}

.menu-item.is-active .menu-label {
  color: var(--cdh-blue-700);
}

.menu-desc {
  display: block;
  margin-top: 2px;
  font-size: var(--font-size-4);
  color: var(--text-mute);
}

.search {
  /* Match the Contribute button's ~40px so the bar reads as one row */
  --pf-input-height: 40px;

  flex: 0 1 260px;
  margin-left: auto;
}

/* Block, not pagefind's inline-block: the baseline descender gap under the
   inline-block trigger nudged it ~2px off the flex row's centre */
.search :global(pagefind-modal-trigger) {
  --pf-font: var(--sans);
  --pf-background: var(--surface);
  --pf-border: var(--border-strong);
  --pf-border-focus: var(--cdh-blue-300);
  --pf-border-radius: var(--radius-sm);
  --pf-outline-width: 0px;

  display: block;
}

.search :global(pagefind-modal-trigger:focus-within),
.search
  :global(pagefind-modal-trigger:has(.pf-trigger-btn[aria-expanded="true"])) {
  --pf-border: var(--cdh-blue-700);
  --pf-border-focus: var(--cdh-blue-700);
}

.search :global(.trigger-compact) {
  display: none;
}

/* Below this the bar is too tight for the labelled trigger — it gets squeezed
   until its placeholder wraps onto three lines and pushes the GitHub icon off
   the edge. Swap to the icon-only compact one Pagefind provides */
@media (width <= 1320px) {
  .search {
    flex: 0 0 auto;
  }

  .search :global(.trigger-full) {
    display: none;
  }

  .search :global(.trigger-compact) {
    display: block;
  }
}

.cta {
  flex-shrink: 0;
  padding: var(--space-2) var(--space-4);
  font-size: var(--font-size-5);
  white-space: nowrap;
}

/* Never let the icon be the thing that gets squeezed out of the row */
.gh {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  color: var(--grey-5);
}

.gh:hover {
  color: var(--cdh-blue-950);
}

.menu-btn {
  display: none;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  color: var(--cdh-blue-950);
  background: transparent;
  border: 0;
}

.menu-btn .i-close,
header:has(#mobile-menu:popover-open) .i-open {
  display: none;
}

header:has(#mobile-menu:popover-open) .i-close {
  display: block;
}

/* Top-layer popover pinned just below the sticky header */
.mobile-menu {
  position: fixed;
  inset: var(--nav-height) 0 auto;
  width: auto;
  padding: 0;
  margin: 0;
  background: var(--bg);
  border: 0;
  border-top: 1px solid var(--border);
}

/* No popover support (pre-2024 browser): hide the menu entirely rather than
   render it permanently expanded in the page flow */
@supports not selector(:popover-open) {
  .mobile-menu {
    display: none;
  }
}

/* Belt-and-braces: never show it at desktop widths, even if it was opened
   just before a resize (author display beats the UA popover rule) */
@media (width > 1100px) {
  .mobile-menu {
    display: none;
  }
}

@media (width <= 1100px) {
  .bar {
    gap: 14px;
  }

  .bar > nav,
  .cta,
  .gh {
    display: none;
  }

  .menu-btn {
    display: inline-flex;
    flex-shrink: 0;
    margin-right: calc(-1 * var(--space-2));
  }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding: var(--space-2) 20px var(--space-4);
  }

  .mobile-menu a {
    padding: 13px var(--space-1);
    font-size: var(--font-size-6);
    font-weight: 500;
    color: var(--text);
    border-bottom: 1px solid var(--border);
  }

  .mobile-menu a:hover {
    text-decoration: none;
  }

  .mobile-menu a.is-active {
    padding-left: var(--space-3);
    color: var(--cdh-blue-950);
    box-shadow: inset 4px 0 0 var(--cdh-blue-300);
  }

  .mobile-menu a:last-child {
    border-bottom: 0;
  }
}

/* Narrow phones: the full wordmark pushes the menu button off-screen */
@media (width <= 360px) {
  .bar :global(.wordmark) {
    display: none;
  }
}
</style>
