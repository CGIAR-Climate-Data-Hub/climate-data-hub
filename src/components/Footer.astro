---
import { issueUrl } from "@/lib/github";
import { GITHUB_URL, SITE_REPO } from "@/site.config";
import LogoBlock from "./LogoBlock.astro";

const GROUPS = [
  [
    "Explore",
    [
      ["Catalog", "/catalog/"],
      ["In use", "/in-use/"],
      ["AI tools", "/ai/"],
    ],
  ],
  [
    "Learn",
    [
      ["Tutorials", "/tutorials/"],
      ["Wikis", "/wikis/"],
    ],
  ],
  [
    "About",
    [
      ["About", "/about/"],
      ["FAQ", "/faq/"],
      [
        "Climate Action Program",
        "https://www.cgiar.org/cgiar-research-portfolio-2025-2030/climate-action",
      ],
    ],
  ],
  [
    "Get involved",
    [
      ["Contribute", "/contribute/"],
      ["Report an issue", issueUrl(SITE_REPO)],
      ["GitHub", GITHUB_URL],
    ],
  ],
] as const;

const year = new Date().getFullYear();

// The ONE sanctioned CGIAR-green band — green never appears beside program blue elsewhere.
---

<footer>
  <div class="container top">
    <div class="brand">
      <LogoBlock variant="dark" />
    </div>
    {GROUPS.map(([title, links]) => (
        <nav aria-label={title}>
          <h2 class="label">{title}</h2>
          {links.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
        </nav>
      ))}
  </div>
  <div class="container legal">
    <span>&copy; {year} CGIAR.</span>
    <span>
      Site content{" "}
      <a href="https://creativecommons.org/licenses/by/4.0/" rel="noreferrer"
        >CC BY 4.0</a
      >, code{" "}
      <a href="https://spdx.org/licenses/MIT.html" rel="noreferrer">MIT</a>.
      Dataset-specific licenses apply.
    </span>
  </div>
</footer>

<style>
footer {
  padding: 24px 0 18px;
  margin-top: 96px;
  color: var(--cgiar-text);
  background: var(--cgiar-primary);
  border-top: 3px solid var(--cgiar-accent);
}

/* Brand sized to its logos, the four groups splitting what's left evenly —
   right-aligning them instead leaves a dead zone beside the wordmark */
.top {
  display: grid;
  grid-template-columns: auto repeat(4, 1fr);
  gap: var(--space-6);
}

.brand {
  display: flex;
  flex-wrap: wrap;
  gap: 22px;
  align-items: center;
}

nav {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

nav .label {
  color: var(--cgiar-text-muted);
}

nav a {
  font-size: var(--font-size-5);
  line-height: 1.4;
  color: var(--cgiar-text);
}

nav a:hover {
  color: var(--text-inverse);
}

.legal {
  display: flex;
  gap: var(--space-2);
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-4);
  font-size: var(--font-size-3);
  color: var(--cgiar-text-muted);
}

.legal a {
  color: var(--cgiar-text-link);
  text-decoration: underline;
}

.legal a:hover {
  color: var(--text-inverse);
}

@media (width <= 1080px) {
  .top {
    grid-template-columns: 1fr 1fr;
  }

  .brand {
    grid-column: 1 / -1;
  }
}

/* Phones: columns would stack into one long ladder — lay each group out as an
   inline "Explore: a b c" row instead */
@media (width <= 640px) {
  .top {
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  nav {
    flex-flow: row wrap;
    gap: 6px 14px;
    align-items: baseline;
  }

  nav .label::after {
    content: ":";
  }

  /* Stack outright: left to itself the licence span shrinks to a narrow
     ragged column beside the copyright instead of dropping below it */
  .legal {
    flex-direction: column;
    gap: var(--space-1);
    text-align: center;
  }
}
</style>
