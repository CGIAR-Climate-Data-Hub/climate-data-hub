---
// Book-like "Contents" nav shared by the wiki landing and articles.
import { getCollection } from "astro:content";
import { groupWikis } from "@/lib/collections";
import { treeUrl } from "@/lib/github";
import { SITE_REPO } from "@/site.config";

interface Props {
  activeId?: string;
}

const { activeId } = Astro.props;

// Sections open by default — remove one to start it collapsed. The section
// holding the current page always opens regardless.
const DEFAULT_OPEN = new Set(["Data standards", "Methods", "Concepts"]);

type Item = { title: string; href?: string; id?: string; soon?: boolean };

const nav = groupWikis(await getCollection("wikis")).map((group) => ({
  label: group.section,
  items: group.entries.map(
    (e): Item => ({
      title: e.data.title,
      href: e.data.soon ? undefined : `/wikis/${e.id}/`,
      id: e.id,
      soon: e.data.soon,
    }),
  ),
  open:
    DEFAULT_OPEN.has(group.section)
    || group.entries.some((e) => e.id === activeId),
}));
---

<nav aria-label="Wiki contents" data-pagefind-ignore>
  <div class="label contents">Contents</div>
  {nav.map((group) => (
      <details class="group" open={group.open}>
        <summary class="group-label">{group.label}</summary>
        {group.items.map((item) =>
          item.soon ? (
            <span class="item soon">
              {item.title}
              <span class="mono soon-tag">SOON</span>
            </span>
          ) : (
            <a href={item.href} class:list={["item", { "is-active": item.id !== undefined && item.id === activeId }]}>
              {item.title}
            </a>
          ),
        )}
      </details>
    ))}
  <div class="contribute">
    <div class="label">Contribute</div>
    <p>
      Open a pull request against the <span class="mono">wikis</span> folder.
      Articles are reviewed by two stewards.
    </p>
    <a href={treeUrl(SITE_REPO, "src/content/wikis")}>
      <svg
        aria-hidden="true"
        fill="currentColor"
        height="13"
        viewBox="0 0 24 24"
        width="13"
      >
        <path
          d="M12 .5C5.7.5.5 5.7.5 12.1c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2 1-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.6 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"
        ></path>
      </svg>
      Open the wiki repo
    </a>
  </div>
</nav>

<style>
nav {
  position: sticky;
  top: calc(var(--nav-height) + 24px);
  align-self: start;
}

.contents {
  margin-bottom: 18px;
  font-size: var(--font-size-1);
  color: var(--text-mute);
}

.group {
  margin-bottom: var(--space-5);
}

.group-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10px;
  font-size: var(--font-size-2);
  font-weight: 700;
  color: var(--cdh-blue-950);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  cursor: pointer;
  user-select: none;
  list-style: none;
}

.group-label::after {
  font-weight: 400;
  color: var(--text-mute);
  content: "+";
}

details[open] > .group-label::after {
  content: "−";
}

.item {
  display: block;
  padding: 7px var(--space-3);
  font-size: var(--font-size-5);
  color: var(--text-soft);
  border-left: 2px solid transparent;
  transition:
    color 0.12s,
    background 0.12s;
}

.item:hover {
  color: var(--cdh-blue-950);
  text-decoration: none;
  background: var(--bg);
}

.item.is-active {
  font-weight: 600;
  color: var(--cdh-blue-950);
  background: var(--grey-1);
  border-left-color: var(--terra-700);
}

.item.soon {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text-mute);
  cursor: default;
}

.soon-tag {
  font-size: var(--font-size-1);
  letter-spacing: 0.1em;
}

.contribute {
  padding: var(--space-4);
  margin-top: var(--space-2);
  background: var(--grey-1);
  border-radius: var(--radius-lg);
}

.contribute .label {
  margin-bottom: var(--space-2);
  font-size: var(--font-size-1);
  color: var(--text-soft);
}

.contribute p {
  font-size: var(--font-size-4);
  line-height: 1.55;
  color: var(--text-soft);
}

.contribute p .mono {
  font-size: var(--font-size-3);
}

.contribute a {
  display: inline-flex;
  gap: 7px;
  align-items: center;
  margin-top: var(--space-3);
  font-size: var(--font-size-4);
  font-weight: 600;
}
</style>
