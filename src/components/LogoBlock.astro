---
import caspLogo from "@/assets/CASP_logo.svg";
import caspLogoWhite from "@/assets/CASP_logo_white.svg";
import { SITE_NAME } from "@/site.config";

interface Props {
  variant?: "light" | "dark";
}

const { variant = "light" } = Astro.props;
const onDark = variant === "dark";
---

<a
  aria-label={`${SITE_NAME} home`}
  href="/"
  class:list={["logo-block", { dark: onDark }]}
>
  <img
    alt=""
    height="56"
    src={onDark ? caspLogoWhite.src : caspLogo.src}
    width="117"
  >
  <span class="wordmark">{SITE_NAME}</span>
</a>

<style>
.logo-block {
  display: inline-flex;
  flex-shrink: 0;
  gap: var(--space-2);
  align-items: center;
  text-decoration: none;
}

.logo-block:hover {
  text-decoration: none;
}

/* Sized here, not by props: the CASP logo sets "CGIAR CLIMATE ACTION" in
   three lines inside itself, so it needs ~56px to stay readable — nothing
   like the size the wordmark beside it wants */
img {
  width: auto;
  height: 56px;
}

.dark img {
  height: 48px;
}

/* Matches where the header collapses to its hamburger and shortens */
@media (width <= 1100px) {
  img {
    height: 46px;
  }
}

/* Rule inset to ~1.5x the text rather than run full-bleed — at the lockup's
   full height it reads as an edge of the CASP box, not a separator */
.wordmark {
  display: flex;
  align-items: center;
  padding-block: 0.25em;
  padding-left: var(--space-2);
  font-family: var(--serif);
  font-size: var(--font-size-8);
  font-weight: 500;
  line-height: 1;
  color: var(--cdh-blue-950);
  letter-spacing: -0.01em;
  white-space: nowrap;
  border-left: 1px solid var(--border-strong);
}

.dark .wordmark {
  font-size: var(--font-size-9);
  color: var(--text-inverse);
  border-left-color: var(--border-inverse);
}
</style>
